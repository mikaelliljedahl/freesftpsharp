{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.HtmlFile"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.HttpsPolicy.HttpsRedirectionMiddleware": "Error"
      }
    },
    "WriteTo": {
      "File": {
        "Name": "File",
        "Args": {
          "path": "logs/FxSshServer.txt",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10000000
        }
      },
      "HtmlFile": {
        "Name": "HtmlFile",
        "Args": {
          "path": "logs/html/FxSshServer.html",
          "fileSizeLimitBytes": 10000000
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      }
    }
  },
  "AdminAuth": {
    "UserName": "admin",
    "PasswordHash": ""
  },
  "Api": {
    "Enabled": false
  }
}
