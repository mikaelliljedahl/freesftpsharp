<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <UserSecretsId>fxsshsftpserver-admin-ui</UserSecretsId>
    <!-- Npgsql.EntityFrameworkCore.PostgreSQL 11.0.0-rc.3 pins EF Core rc.3; SshServer.Settings.PostgreSql lifts it to 11.0.0 (NU1608). Remove with the 11.0.0 release. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="11.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.HtmlFile" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SshServer.Filesystem.LocalDisk\SshServer.Filesystem.LocalDisk.csproj" />
    <ProjectReference Include="..\SshServer.Filesystem.AzureBlob\SshServer.Filesystem.AzureBlob.csproj" />
    <ProjectReference Include="..\SshServer.Filesystem.S3\SshServer.Filesystem.S3.csproj" />
    <ProjectReference Include="..\SshServer.Filesystem.Gcs\SshServer.Filesystem.Gcs.csproj" />
    <ProjectReference Include="..\SshServer.Filesystem.Encrypted\SshServer.Filesystem.Encrypted.csproj" />
    <ProjectReference Include="..\SshServer.Administration\SshServer.Administration.csproj" />
    <ProjectReference Include="..\SshServer.Api\SshServer.Api.csproj" />
    <ProjectReference Include="..\SshServer.Observability\SshServer.Observability.csproj" />
    <ProjectReference Include="..\SshServer.Settings.Sql\SshServer.Settings.Sql.csproj" />
    <ProjectReference Include="..\SshServer.Settings.PostgreSql\SshServer.Settings.PostgreSql.csproj" />
    <ProjectReference Include="..\SshServer.Settings.SqlServer\SshServer.Settings.SqlServer.csproj" />
    <ProjectReference Include="..\SshServerModule\SshServerModule.csproj" />
    <ProjectReference Include="..\SshServer.Webhooks\SshServer.Webhooks.csproj" />
    <ProjectReference Include="..\FreeSftpSharp.WebDav\FreeSftpSharp.WebDav.csproj" />
    <ProjectReference Include="..\SshServer.TwoFactor\SshServer.TwoFactor.csproj" />
    <ProjectReference Include="..\SshServer.EventRules\SshServer.EventRules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The admin security core (claims, policies, CurrentAdmin, the scoped services) is in SshServer.Administration, shared with the REST API. -->
    <Using Include="SshServer.Administration" />
  </ItemGroup>

</Project>
