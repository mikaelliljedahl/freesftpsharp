@page
@model FxSshSftpServer.Pages.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log in - FxSshSftpServer</title>
    <script src="~/js/theme.js"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="d-flex align-items-center min-vh-100 py-4">
    <main class="container" style="max-width: 24rem;">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h4 mb-1 d-flex align-items-center gap-2"><i class="bi bi-hdd-network text-primary"></i> FreeSftpSharp</h1>
                <p class="text-body-secondary mb-4">Log in to the admin UI.</p>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
                }
                @if (Model.ShowLocalLogin)
                {
                    <form method="post" id="local-login">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label">User name</label>
                            <input asp-for="UserName" class="form-control" autocomplete="username" autofocus required />
                        </div>
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" class="form-control" autocomplete="current-password" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Log in</button>
                    </form>
                }
                @if (Model.Oidc.IsEnabled)
                {
                    @if (Model.ShowLocalLogin)
                    {
                        <div class="text-center text-body-secondary small my-3">or</div>
                    }
                    <a asp-page-handler="Oidc" asp-route-ReturnUrl="@Model.ReturnUrl" id="oidc-login" class="btn @(Model.ShowLocalLogin ? "btn-outline-primary" : "btn-primary") w-100"><i class="bi bi-box-arrow-in-right"></i> Sign in with @Model.Oidc.DisplayName</a>
                }
            </div>
        </div>
    </main>
</body>
</html>
