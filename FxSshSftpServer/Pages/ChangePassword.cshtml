@page
@model FxSshSftpServer.Pages.ChangePasswordModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change password - FxSshSftpServer</title>
    <script src="~/js/theme.js"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="d-flex align-items-center min-vh-100 py-4">
    <main class="container" style="max-width: 26rem;">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">Change password</h1>
                <p class="text-body-secondary mb-4">
                    Logged in as <strong>@User.Identity?.Name</strong>.
                    @if (Model.MustChange)
                    {
                        <span id="must-change-note">Set a new password before you continue.</span>
                    }
                </p>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger" role="alert" id="change-password-error">@Model.ErrorMessage</div>
                }
                <form method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label">Current password</label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">New password</label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" required />
                        <div class="form-text">At least @SshServer.Interfaces.Admins.AdminAdministrationService.MinimumPasswordLength characters. Your other sessions end.</div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="RepeatPassword" class="form-label">Repeat the new password</label>
                        <input asp-for="RepeatPassword" class="form-control" autocomplete="new-password" required />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Change password</button>
                        @if (!Model.MustChange)
                        {
                            <a class="btn btn-outline-secondary" href="~/">Cancel</a>
                        }
                        else
                        {
                            <a class="btn btn-outline-secondary" href="~/Logout">Log out</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </main>
</body>
</html>
