@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}
<div class="client-narrow">
    <div class="card">
        <div class="card-body p-4">
            <h1 class="h4 mb-1">Change password</h1>
            @if (Model.MustChange)
            {
                <p class="text-body-secondary mb-4" id="must-change-note">Your password has expired. Set a new password before you continue.</p>
            }
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert" id="change-password-error">@Model.ErrorMessage</div>
            }
            @if (Model.ManagedBy != null)
            {
                <a href="/client/account" class="btn btn-link px-0" id="back-to-account">Back to the account</a>
            }
            else
            {
            <form method="post">
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label">Current password</label>
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" required />
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">New password</label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" required />
                    <div class="form-text">At least @SshServer.Interfaces.Users.UserAdministrationService.MinimumPasswordLength characters. Your other browser sessions end.</div>
                </div>
                <div class="mb-4">
                    <label asp-for="RepeatPassword" class="form-label">Repeat the new password</label>
                    <input asp-for="RepeatPassword" class="form-control" autocomplete="new-password" required />
                </div>
                <button type="submit" class="btn btn-primary" id="change-password-submit">Change password</button>
                @if (!Model.MustChange)
                {
                    <a href="/client/account" class="btn btn-link">Cancel</a>
                }
            </form>
            }
        </div>
    </div>
</div>
