@inject NavigationManager Navigation

@* The menu shows only the pages the administrator may open. The pages and their services check the permission again. *@
<ul class="nav nav-pills flex-column gap-1 p-3">
    <li class="nav-item">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="OnNavigate">
            <i class="bi bi-speedometer2"></i> Dashboard
        </NavLink>
    </li>
    <AuthorizeView Policy="@AdminPolicies.ManageUsers">
        <li class="nav-item">
            <NavLink class="nav-link" href="users" @onclick="OnNavigate">
                <i class="bi bi-people"></i> Users
            </NavLink>
        </li>
    </AuthorizeView>
    <AuthorizeView Policy="@AdminPolicies.ViewConnections">
        <li class="nav-item">
            <NavLink class="nav-link" href="connections" @onclick="OnNavigate">
                <i class="bi bi-plug"></i> Connections
            </NavLink>
        </li>
    </AuthorizeView>
    <AuthorizeView Policy="@AdminPolicies.ManageSettings">
        <li class="nav-item">
            <NavLink class="nav-link" href="general" @onclick="OnNavigate">
                <i class="bi bi-gear"></i> Server settings
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="access" @onclick="OnNavigate">
                <i class="bi bi-shield-lock"></i> IP access and bans
            </NavLink>
        </li>
    </AuthorizeView>
    <AuthorizeView Policy="@AdminPolicies.ViewAudit">
        <li class="nav-item">
            <NavLink class="nav-link" href="audit" @onclick="OnNavigate">
                <i class="bi bi-journal-text"></i> Audit
            </NavLink>
        </li>
    </AuthorizeView>
    <AuthorizeView Policy="@AdminPolicies.ManageAdmins">
        <li class="nav-item">
            <NavLink class="nav-link" href="admins" @onclick="OnNavigate">
                <i class="bi bi-person-gear"></i> Admins
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="roles" @onclick="OnNavigate">
                <i class="bi bi-diagram-3"></i> Roles
            </NavLink>
        </li>
    </AuthorizeView>
    <AuthorizeView Policy="@AdminPolicies.ManageEvents">
        <li class="nav-item">
            <NavLink class="nav-link" href="webhooks" @onclick="OnNavigate">
                <i class="bi bi-broadcast"></i> Webhooks
            </NavLink>
        </li>
    </AuthorizeView>
    <li class="nav-item mt-3 border-top pt-3">
        <a class="nav-link" href="ChangePassword" @onclick="ChangePassword" @onclick:preventDefault>
            <i class="bi bi-key"></i> Change password
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="Logout" @onclick="LogOut" @onclick:preventDefault>
            <i class="bi bi-box-arrow-right"></i> Log out
        </a>
    </li>
</ul>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }

    // Logout and ChangePassword are Razor pages, not Blazor routes: load them with a full page request.
    private void LogOut() => Navigation.NavigateTo("Logout", forceLoad: true);

    private void ChangePassword() => Navigation.NavigateTo("ChangePassword", forceLoad: true);
}
