@page "/users"
@attribute [Authorize(Policy = AdminPolicies.ManageUsers)]
@using FxSsh.SshServerModule
@using System.Globalization
@using System.Threading
@using SshServer.Interfaces.Permissions
@using SshServer.Interfaces.Authentication
@using SshServer.Interfaces.Users
@using SshServer.Interfaces.TwoFactor
@inject AdminScopedSettingsRepository SettingsRepository
@inject TwoFactorAdministration TwoFactor
@inject SshServer.Interfaces.Users.UserAdministrationService UserService
@inject SshServerModule.Storage.StorageConfigService StorageService
@inject SshServerModule.Storage.VirtualFolderService FolderService
@inject SshServerModule.Quotas.QuotaAdministrationService QuotaService
@inject SshServer.Interfaces.Groups.GroupService GroupService
@inject SshServer.Interfaces.Users.IEffectiveUserSettingsService UserSettings
@inject IJSRuntime JS
@inject ToastService Toasts

<PageTitle>Users - FreeSftpSharp admin</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h1 class="h3 mb-0">Users</h1>
        <p class="text-body-secondary mb-0">The SFTP accounts. Each user sees only its own storage and virtual folders, with the permissions set per path.</p>
    </div>
    <button type="button" class="btn btn-primary" @onclick="StartNew" id="add-user"><i class="bi bi-person-plus"></i> Add user</button>
</div>

<div class="row g-4">
    <div class="@(form is null ? "col-12" : "col-xl-5")">
        <div class="card">
            <div class="card-header">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="search" class="form-control" placeholder="Search users" aria-label="Search users" id="user-search"
                           @bind="search" @bind:event="oninput" />
                </div>
            </div>
            @if (users.Count == 0)
            {
                <div class="card-body text-body-secondary" id="no-users">No users yet. Use "Add user" to create the first one.</div>
            }
            else
            {
                <div class="table-responsive">
                    <QuickGrid Items="FilteredUsers" Class="table table-hover align-middle quickgrid-table" id="user-table">
                        <PropertyColumn Title="User name" Property="@(u => u.Username)" Sortable="true" InitialSortDirection="SortDirection.Ascending" IsDefaultSortColumn="true" />
                        <TemplateColumn Title="Login">
                            @if (!string.IsNullOrWhiteSpace(context.HashedPassword))
                            {
                                <span class="badge text-bg-secondary me-1">password</span>
                            }
                            @if (context.PublicKeys is { Count: > 0 } keys)
                            {
                                <span class="badge text-bg-info me-1">@(keys.Count == 1 ? "key" : $"{keys.Count} keys")</span>
                            }
                            @if (twoFactorUsers.Contains(context.Id))
                            {
                                <span class="badge text-bg-success me-1" title="Two-factor authentication (TOTP)">2FA</span>
                            }
                            @if (context.RequireAllOf is { Count: > 0 })
                            {
                                <span class="badge text-bg-primary me-1" title="Multi-step login">@context.RequireAllOf.Count-step</span>
                            }
                            @if (context.AppPasswords is { Count: > 0 } appPasswords)
                            {
                                <span class="badge text-bg-light border me-1" title="App passwords">@(appPasswords.Count == 1 ? "app password" : $"{appPasswords.Count} app passwords")</span>
                            }
                            @if (context.AllowedProtocols != UserProtocols.All)
                            {
                                <span class="badge text-bg-dark me-1" title="Allowed protocols">@UserProtocolRules.Describe(context.AllowedProtocols)</span>
                            }
                            @if (context.OnlyWhitelistedIps && context.WhitelistedIps is { Count: > 0 })
                            {
                                <span class="badge text-bg-warning me-1" title="Only from whitelisted networks">IP</span>
                            }
                            @if (context.Status != UserStatus.Enabled)
                            {
                                <span class="badge text-bg-danger me-1 user-disabled">disabled</span>
                            }
                            else if (UserLoginRules.IsExpired(context, DateTime.UtcNow))
                            {
                                <span class="badge text-bg-danger me-1 user-expired">expired</span>
                            }
                            @if (GroupNames(context) is { Length: > 0 } names)
                            {
                                <span class="badge text-bg-light border user-groups" title="Groups">@names</span>
                            }
                        </TemplateColumn>
                        @if (form is null)
                        {
                            <TemplateColumn Title="Storage" SortBy="@(GridSort<User>.ByAscending(u => u.Storage == null ? u.UserRootDirectory : u.Storage.Provider))" Class="d-none d-md-table-cell">
                                @if (context.Storage is null)
                                {
                                    <span class="font-monospace-sm">@context.UserRootDirectory</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-light border">@StorageService.DisplayName(context.Storage)</span>
                                }
                                @if (context.VirtualFolders is { Count: > 0 } mounts)
                                {
                                    <span class="badge text-bg-secondary ms-1" title="Virtual folders">+@mounts.Count @(mounts.Count == 1 ? "folder" : "folders")</span>
                                }
                                @if (context.DiskQuota is { IsUnlimited: false } || context.TransferQuota is { IsUnlimited: false } || context.Bandwidth is { IsUnlimited: false })
                                {
                                    <span class="badge text-bg-light border ms-1" title="Quotas or bandwidth limits">limits</span>
                                }
                            </TemplateColumn>
                            <TemplateColumn Title="Last login (UTC)" SortBy="@(GridSort<User>.ByAscending(u => u.LastLoginAt))" Class="d-none d-md-table-cell">
                                @LastLogin(context.LastLoginAt)
                            </TemplateColumn>
                        }
                        <TemplateColumn Title="" Align="Align.End">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-primary edit-user" title="Edit" aria-label="Edit @context.Username" @onclick="() => Edit(context)"><i class="bi bi-pencil"></i></button>
                                <button type="button" class="btn btn-outline-danger delete-user" title="Delete" aria-label="Delete @context.Username" @onclick="() => AskDelete(context.Username)"><i class="bi bi-trash"></i></button>
                            </div>
                        </TemplateColumn>
                    </QuickGrid>
                </div>
            }
        </div>
    </div>

    @if (form is not null)
    {
        <div class="col-xl-7">
            <div class="card">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                    <span>@(form.IsNew ? "New user" : $"Edit {form.Username}")</span>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseForm"></button>
                </div>
                <div class="card-body">
                    <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="user-form" id="user-form">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label" for="username">User name</label>
                            <InputText id="username" class="form-control" @bind-Value="form.Username" readonly="@(!form.IsNew)" autocomplete="off" />
                            <ValidationMessage For="() => form.Username" />
                            @if (!form.IsNew)
                            {
                                <div class="form-text">The user name cannot be changed. Create a new user instead.</div>
                            }
                        </div>

                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 fs-6 mb-0">Account</legend>
                            <div class="form-check form-switch mb-2">
                                <InputCheckbox id="user-enabled" class="form-check-input" @bind-Value="form.Enabled" />
                                <label class="form-check-label" for="user-enabled">Enabled: the user may log in</label>
                            </div>
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <label class="form-label" for="user-expires">Expires on (UTC, optional)</label>
                                    <InputDate id="user-expires" class="form-control" @bind-Value="form.ExpiresOn" />
                                    <div class="form-text">From this day on, the user cannot log in.</div>
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label" for="user-max-sessions">Maximum sessions</label>
                                    <InputNumber id="user-max-sessions" class="form-control" @bind-Value="form.MaxSessions" />
                                    <ValidationMessage For="() => form.MaxSessions" />
                                    <div class="form-text">Open at the same time. 0: no limit.</div>
                                </div>
                            </div>
                            <div class="mt-2">
                                <label class="form-label" for="user-description">Description</label>
                                <InputText id="user-description" class="form-control" @bind-Value="form.Description" />
                                <ValidationMessage For="() => form.Description" />
                            </div>
                            @if (!form.Enabled || (form.ExpiresOn is { } expiresOn && expiresOn.Date <= DateTime.UtcNow.Date))
                            {
                                <div class="form-text text-warning-emphasis" id="login-blocked"><i class="bi bi-exclamation-triangle"></i> The user cannot log in. Saving a disabled user closes its open sessions; the sessions of an expired user keep running until they end.</div>
                            }
                        </fieldset>

                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 fs-6 mb-0">Groups</legend>
                            <div class="small text-body-secondary mb-2">
                                A setting that the user does not set itself comes from the primary group, then from the other groups in order.
                                Manage the groups on the <a href="groups">Groups</a> page.
                            </div>
                            @if (groups.Count == 0 && !form.HasGroups)
                            {
                                <div class="small text-body-secondary" id="no-groups">There are no groups yet.</div>
                            }
                            else
                            {
                                <label class="form-label small mb-1" for="primary-group">Primary group</label>
                                <select id="primary-group" class="form-select form-select-sm mb-2" value="@form.PrimaryGroupId" @onchange="OnPrimaryGroupChanged">
                                    <option value="0">None</option>
                                    @foreach (var group in groups)
                                    {
                                        <option value="@group.Id">@group.Name</option>
                                    }
                                    @if (form.PrimaryGroupId != 0 && !groups.Any(g => g.Id == form.PrimaryGroupId))
                                    {
                                        <option value="@form.PrimaryGroupId">A group outside your scope</option>
                                    }
                                </select>
                                <div class="small mb-1">Secondary groups</div>
                                @foreach (var group in groups.Where(g => g.Id != form.PrimaryGroupId))
                                {
                                    var id = group.Id;
                                    <div class="form-check form-check-inline">
                                        <input type="checkbox" class="form-check-input secondary-group" id="secondary-group-@id" checked="@form.SecondaryGroupIds.Contains(id)"
                                               @onchange="e => ToggleSecondaryGroup(id, e.Value is true)" />
                                        <label class="form-check-label" for="secondary-group-@id">@group.Name</label>
                                    </div>
                                }
                                @if (form.SecondaryGroupIds.Any(id => !groups.Any(g => g.Id == id)))
                                {
                                    <div class="form-text">The user is also in groups outside your scope; they stay.</div>
                                }
                            }
                            @if (groupProblems is { Count: > 0 })
                            {
                                <ul class="text-danger small mb-0 mt-2 ps-3" id="group-problems">
                                    @foreach (var problem in groupProblems)
                                    {
                                        <li>@problem</li>
                                    }
                                </ul>
                            }
                        </fieldset>

                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 fs-6 mb-0">Storage</legend>
                            <StorageEditor Settings="form.Storage" IdPrefix="user-storage" Problems="storageProblems"
                                           DefaultLabel="Default: a directory on the server" OnProviderChanged="() => storageProblems = null" />
                        @if (form.UsesDefaultStorage)
                        {
                        <div class="mb-0">
                            <label class="form-label" for="root-directory">Root directory</label>
                            <InputText id="root-directory" class="form-control font-monospace" @bind-Value="form.UserRootDirectory" placeholder="/srv/sftp/user" />
                            <ValidationMessage For="() => form.UserRootDirectory" />
                            @if (!string.IsNullOrWhiteSpace(form.UserRootDirectory) && !System.IO.Directory.Exists(form.UserRootDirectory.Trim()))
                            {
                                <div class="form-text text-warning-emphasis" id="root-missing"><i class="bi bi-exclamation-triangle"></i> This directory does not exist on the server. The user cannot work with files until it is created.</div>
                            }
                            else
                            {
                                <div class="form-text">A directory on the server. The user sees it as <code>/</code> and cannot leave it.</div>
                            }
                        </div>
                        }
                        </fieldset>

                        <MountEditor Mounts="form.Mounts" Folders="folders" Problems="mountProblems" />

                        <QuotaEditor Model="form.Quotas">
                            @if (quotaView is { IsEmpty: false } view)
                            {
                                <div class="border-top mt-3 pt-3" id="quota-usage">
                                    <div class="fw-semibold small mb-1">Usage</div>
                                    <ul class="list-unstyled small mb-2">
                                        @foreach (var scope in view.Disk)
                                        {
                                            <li class="quota-usage-row">
                                                <span class="font-monospace-sm">@scope.Label</span>:
                                                @Size(scope.Usage.UsedBytes)@(scope.Limit.MaxSizeBytes > 0 ? $" of {Size(scope.Limit.MaxSizeBytes)}" : ""),
                                                @Math.Max(0, scope.Usage.UsedFiles) @(scope.Limit.MaxFiles > 0 ? $"of {scope.Limit.MaxFiles} files" : "files")
                                                <span class="text-body-secondary">
                                                    (@(scope.Usage.ScannedAt is { } scanned ? "scanned " + scanned.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC" : "never scanned")@(scope.ScanQueued ? ", scan queued" : ""))
                                                </span>
                                            </li>
                                        }
                                        @if (view.Transfer is { } transfer)
                                        {
                                            <li id="transfer-usage">
                                                Transferred: uploaded @Size(view.TransferUsage.UploadedBytes)@(transfer.MaxUploadBytes > 0 ? $" of {Size(transfer.MaxUploadBytes)}" : ""),
                                                downloaded @Size(view.TransferUsage.DownloadedBytes)@(transfer.MaxDownloadBytes > 0 ? $" of {Size(transfer.MaxDownloadBytes)}" : "")@(transfer.MaxTotalBytes > 0 ? $", total limit {Size(transfer.MaxTotalBytes)}" : "")
                                            </li>
                                        }
                                    </ul>
                                    <div class="d-flex flex-wrap gap-2">
                                        @if (view.Disk.Count > 0)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" id="rescan-quota" @onclick="RescanQuota"><i class="bi bi-arrow-repeat"></i> Rescan quota</button>
                                        }
                                        @if (view.Transfer is not null)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" id="reset-transfer" @onclick="ResetTransferAsync"><i class="bi bi-arrow-counterclockwise"></i> Reset transfer counters</button>
                                        }
                                    </div>
                                </div>
                            }
                        </QuotaEditor>
                        <ValidationMessage For="() => form.Quotas" />

                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 fs-6 mb-0">Password</legend>
                            <div class="small text-body-secondary mb-2">
                                @if (form.HasPassword)
                                {
                                    <span>A password is set. Enter a new one to change it.</span>
                                }
                                else
                                {
                                    <span>No password is set.</span>
                                }
                                Passwords are stored as salted PBKDF2-SHA256 hashes.
                            </div>
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <label class="form-label" for="new-password">New password</label>
                                    <InputText id="new-password" type="password" class="form-control" @bind-Value="form.NewPassword" autocomplete="new-password" />
                                    <ValidationMessage For="() => form.NewPassword" />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label" for="confirm-password">Repeat the password</label>
                                    <InputText id="confirm-password" type="password" class="form-control" @bind-Value="form.ConfirmPassword" autocomplete="new-password" />
                                    <ValidationMessage For="() => form.ConfirmPassword" />
                                </div>
                            </div>
                            @if (form.HasPassword)
                            {
                                <div class="form-check mt-2">
                                    <InputCheckbox id="remove-password" class="form-check-input" @bind-Value="form.RemovePassword" />
                                    <label class="form-check-label" for="remove-password">Remove the password (the user then logs in with a key only)</label>
                                </div>
                            }
                        </fieldset>

                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 fs-6 mb-0">Public keys</legend>
                            @if (form.IsNew)
                            {
                                <div class="small text-body-secondary">Save the user first, then add or generate keys.</div>
                            }
                            else
                            {
                                @if (form.PublicKeys.Count == 0)
                                {
                                    <div class="small text-body-secondary mb-2" id="no-keys">No keys. Add the public key of the user (an OpenSSH <code>.pub</code> line or an <code>authorized_keys</code> file), or generate one: the server keeps the public key, and your browser downloads the private key once.</div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle mb-2" id="key-table">
                                            <thead>
                                                <tr>
                                                    <th scope="col">Type</th>
                                                    <th scope="col">Fingerprint</th>
                                                    <th scope="col">Comment</th>
                                                    <th scope="col">Added (UTC)</th>
                                                    <th scope="col">Expires (UTC)</th>
                                                    <th scope="col"><span class="visually-hidden">Remove</span></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var key in form.PublicKeys)
                                                {
                                                    <tr class="key-row">
                                                        <td class="small text-nowrap">@key.KeyType</td>
                                                        <td><span class="font-monospace-sm key-fingerprint">@key.Fingerprint</span></td>
                                                        <td class="small">@key.Comment</td>
                                                        <td class="small text-nowrap">@Date(key.AddedAt)</td>
                                                        <td class="small text-nowrap">
                                                            @if (key.ExpiresAt is { } expires)
                                                            {
                                                                @Date(expires)
                                                                @if (key.IsExpired(DateTime.UtcNow))
                                                                {
                                                                    <span class="badge text-bg-danger ms-1">expired</span>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <span class="text-body-secondary">never</span>
                                                            }
                                                        </td>
                                                        <td class="text-end">
                                                            <button type="button" class="btn btn-sm btn-outline-danger remove-key" title="Remove" aria-label="Remove the key @key.Fingerprint"
                                                                    @onclick="() => AskRemoveKey(key)"><i class="bi bi-x"></i></button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                <label class="form-label small mb-1" for="new-keys">Add keys</label>
                                <textarea id="new-keys" class="form-control form-control-sm font-monospace mb-2" rows="3" placeholder="ssh-ed25519 AAAA... user@laptop"
                                          @bind="newKeysText"></textarea>
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <label class="small" for="new-keys-expiry">Expires on (UTC, optional)</label>
                                    <input type="date" id="new-keys-expiry" class="form-control form-control-sm w-auto" @bind="newKeysExpiry" />
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddKeys" id="add-keys"><i class="bi bi-plus"></i> Add from text</button>
                                </div>
                                @if (keyError is not null)
                                {
                                    <div class="small text-danger mb-2" id="key-error" style="white-space: pre-line">@keyError</div>
                                }
                                <div class="form-text mb-2">One key per line: ed25519, ECDSA or RSA (at least 2048 bits). Options such as <code>from=</code> or <code>restrict</code> are not supported. A login compares the whole key.</div>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => GenerateKeyAsync(ed25519: true)" disabled="@generatingKey" id="generate-ed25519-key">
                                        <i class="bi bi-key"></i> Generate an ed25519 key
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => GenerateKeyAsync(ed25519: false)" disabled="@generatingKey" id="generate-key">
                                        @if (generatingKey)
                                        {
                                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                        }
                                        <i class="bi bi-key"></i> Generate an RSA key
                                    </button>
                                </div>
                            }
                        </fieldset>

                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 fs-6 mb-0">Login methods</legend>
                            <div class="form-check form-check-inline">
                                <InputCheckbox id="allow-password" class="form-check-input" @bind-Value="form.AllowPassword" />
                                <label class="form-check-label" for="allow-password">Password</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <InputCheckbox id="allow-public-key" class="form-check-input" @bind-Value="form.AllowPublicKey" />
                                <label class="form-check-label" for="allow-public-key">Public key</label>
                            </div>
                            <div class="mt-2">
                                <label class="form-label small mb-1" for="multi-step">Multi-step login</label>
                                <InputSelect id="multi-step" class="form-select form-select-sm w-auto" @bind-Value="form.MultiStep">
                                    <option value="">Off: one allowed method is enough</option>
                                    <option value="@UserForm.KeyThenPassword">Public key, then password</option>
                                    <option value="@UserForm.PasswordThenKey">Password, then public key</option>
                                    <option value="@UserForm.KeyThenKeyboardInteractive">Public key, then keyboard-interactive</option>
                                </InputSelect>
                            </div>
                            <ValidationMessage For="() => form.AllowPassword" />
                            <div class="form-text">
                                A method that is not allowed fails like a wrong password. With a multi-step login the user needs both methods, in this order.
                                Keyboard-interactive asks for the verification code when the user has two-factor authentication, otherwise for the password.
                            </div>
                        </fieldset>

                        @if (!form.IsNew)
                        {
                            <fieldset class="border rounded p-3 mb-3">
                                <legend class="float-none w-auto px-2 fs-6 mb-0">Two-factor authentication</legend>
                                <TwoFactorPanel Target="TwoFactorTarget.User(form.Username)" OnChanged="LoadTwoFactorAsync" />
                            </fieldset>
                        }

                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 fs-6 mb-0">Protocols</legend>
                            <div class="form-check form-check-inline">
                                <InputCheckbox id="allow-sftp" class="form-check-input" @bind-Value="form.AllowSftp" />
                                <label class="form-check-label" for="allow-sftp">SFTP</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <InputCheckbox id="allow-webdav" class="form-check-input" @bind-Value="form.AllowWebDav" />
                                <label class="form-check-label" for="allow-webdav">WebDAV</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <InputCheckbox id="allow-ftp" class="form-check-input" @bind-Value="form.AllowFtp" />
                                <label class="form-check-label" for="allow-ftp">FTP/FTPS</label>
                            </div>
                            <ValidationMessage For="() => form.AllowSftp" />
                            <div class="form-text">SFTP refuses a protocol that is not allowed like a wrong password; WebDAV answers 403 and FTP 530 after a correct password. WebDAV and FTP must also be turned on for the server (<code>WebDav:Enabled</code>, <code>Ftp:Enabled</code>).</div>
                        </fieldset>

                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 fs-6 mb-0">App passwords</legend>
                            @if (form.IsNew)
                            {
                                <div class="small text-body-secondary">Save the user first, then create app passwords.</div>
                            }
                            else
                            {
                                @if (newAppPassword is not null)
                                {
                                    <div class="alert alert-success py-2 small" id="new-app-password-box">
                                        The new app password. Copy it now; it is not shown again:
                                        <div class="font-monospace fs-6 mt-1 user-select-all" id="new-app-password">@newAppPassword</div>
                                    </div>
                                }
                                @if (form.AppPasswords.Count == 0)
                                {
                                    <div class="small text-body-secondary mb-2" id="no-app-passwords">No app passwords. An app password is a random password for a client that cannot do the normal login, for example a WebDAV client of a user with a multi-step login. The server keeps only its hash.</div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle mb-2" id="app-password-table">
                                            <thead>
                                                <tr>
                                                    <th scope="col">Name</th>
                                                    <th scope="col">Protocols</th>
                                                    <th scope="col">Created (UTC)</th>
                                                    <th scope="col">Expires (UTC)</th>
                                                    <th scope="col"><span class="visually-hidden">Remove</span></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var appPassword in form.AppPasswords)
                                                {
                                                    <tr class="app-password-row">
                                                        <td class="small">@appPassword.Name</td>
                                                        <td class="small">@UserProtocolRules.Describe(appPassword.Protocols)</td>
                                                        <td class="small text-nowrap">@Date(appPassword.CreatedAt)</td>
                                                        <td class="small text-nowrap">
                                                            @if (appPassword.ExpiresAt is { } expires)
                                                            {
                                                                @Date(expires)
                                                                @if (appPassword.IsExpired(DateTime.UtcNow))
                                                                {
                                                                    <span class="badge text-bg-danger ms-1">expired</span>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <span class="text-body-secondary">never</span>
                                                            }
                                                        </td>
                                                        <td class="text-end">
                                                            <button type="button" class="btn btn-sm btn-outline-danger remove-app-password" title="Remove" aria-label="Remove the app password @appPassword.Name"
                                                                    @onclick="() => RemoveAppPassword(appPassword)"><i class="bi bi-x"></i></button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <label class="small visually-hidden" for="app-password-name">Name</label>
                                    <input id="app-password-name" class="form-control form-control-sm w-auto" placeholder="Name, for example Laptop" @bind="appPasswordName" />
                                    <div class="form-check form-check-inline mb-0">
                                        <input type="checkbox" id="app-password-webdav" class="form-check-input" @bind="appPasswordWebDav" />
                                        <label class="form-check-label small" for="app-password-webdav">WebDAV</label>
                                    </div>
                                    <div class="form-check form-check-inline mb-0">
                                        <input type="checkbox" id="app-password-sftp" class="form-check-input" @bind="appPasswordSftp" />
                                        <label class="form-check-label small" for="app-password-sftp">SFTP</label>
                                    </div>
                                    <div class="form-check form-check-inline mb-0">
                                        <input type="checkbox" id="app-password-ftp" class="form-check-input" @bind="appPasswordFtp" />
                                        <label class="form-check-label small" for="app-password-ftp">FTP</label>
                                    </div>
                                    <label class="small" for="app-password-expiry">Expires on (UTC, optional)</label>
                                    <input type="date" id="app-password-expiry" class="form-control form-control-sm w-auto" @bind="appPasswordExpiry" />
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="CreateAppPassword" id="create-app-password"><i class="bi bi-plus"></i> Create</button>
                                </div>
                                @if (appPasswordError is not null)
                                {
                                    <div class="small text-danger mt-2" id="app-password-error">@appPasswordError</div>
                                }
                            }
                        </fieldset>

                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 fs-6 mb-0">IP whitelist</legend>
                            <div class="form-check form-switch mb-2">
                                <InputCheckbox id="user-whitelist-mode" class="form-check-input" @bind-Value="form.OnlyWhitelistedIps" />
                                <label class="form-check-label" for="user-whitelist-mode">This user may log in only from these networks</label>
                            </div>
                            <InputTextArea id="user-whitelist" class="form-control font-monospace" rows="3" @bind-Value="form.WhitelistedIps" placeholder="192.168.1.0/24" />
                            <ValidationMessage For="() => form.WhitelistedIps" />
                            <div class="form-text">CIDR networks or single addresses, one per line. With an empty list nothing is checked.</div>
                        </fieldset>

                        @if (form.HasGroups)
                        {
                            <div class="border rounded p-3 mb-3">
                                <div class="form-check form-switch mb-0">
                                    <InputCheckbox id="inherit-permissions" class="form-check-input" @bind-Value="form.InheritPermissions" />
                                    <label class="form-check-label" for="inherit-permissions">Use the permissions and path filters of the groups</label>
                                </div>
                                <div class="form-text">Off: the user has its own permissions below, and a group cannot change them.</div>
                            </div>
                        }
                        @if (form.UsesOwnPermissions)
                        {
                            <PermissionEditor Permissions="form.Permissions" PathFilters="form.PathFilters">
                                <PermissionMessages><ValidationMessage For="() => form.Permissions" /></PermissionMessages>
                                <FilterMessages><ValidationMessage For="() => form.PathFilters" /></FilterMessages>
                            </PermissionEditor>
                        }

                        @if (form.HasGroups && Preview() is { } effective)
                        {
                            <div class="card border-info-subtle mb-3" id="effective-settings">
                                <div class="card-header small fw-semibold">Effective settings</div>
                                <ul class="list-group list-group-flush small">
                                    <li class="list-group-item" id="effective-storage">
                                        <span class="fw-semibold">Storage:</span>
                                        @if (effective.StorageProblem is not null)
                                        {
                                            <span class="text-danger">@effective.StorageProblem</span>
                                        }
                                        else
                                        {
                                            @(effective.Storage is null ? "the default storage (the root directory)" : StorageService.DisplayName(effective.Storage))
                                        }
                                        <span class="badge text-bg-light border ms-1 origin">@effective.StorageOrigin</span>
                                    </li>
                                    <li class="list-group-item" id="effective-permissions">
                                        <span class="fw-semibold">Permissions:</span>
                                        @string.Join("; ", effective.Permissions.Permissions.OrderBy(p => p.Key, StringComparer.Ordinal).Select(p => $"{p.Key} {PermissionText(p.Value)}"))
                                        <span class="badge text-bg-light border ms-1 origin">@effective.PermissionsOrigin</span>
                                    </li>
                                    <li class="list-group-item" id="effective-filters">
                                        <span class="fw-semibold">Path filters:</span>
                                        @(effective.Permissions.Filters.Count == 0 ? "none" : string.Join(", ", effective.Permissions.Filters.Keys.Order(StringComparer.Ordinal)))
                                        <span class="badge text-bg-light border ms-1 origin">@effective.PathFiltersOrigin</span>
                                    </li>
                                    <li class="list-group-item" id="effective-folders">
                                        <span class="fw-semibold">Virtual folders:</span>
                                        @if (effective.VirtualFolders.Count == 0)
                                        {
                                            <span>none</span>
                                        }
                                        @foreach (var mount in effective.VirtualFolders)
                                        {
                                            <span class="me-2"><code>@mount.MountPath</code> <span class="badge text-bg-light border origin">@mount.Origin</span></span>
                                        }
                                    </li>
                                    <li class="list-group-item" id="effective-methods">
                                        <span class="fw-semibold">Login methods:</span> @effective.AllowedAuthMethods
                                        <span class="badge text-bg-light border ms-1 origin">@effective.AllowedAuthMethodsOrigin</span>
                                    </li>
                                    <li class="list-group-item" id="effective-networks">
                                        <span class="fw-semibold">Allowed networks:</span>
                                        @(effective.AllowedIps.Count == 0 ? "any" : string.Join(", ", effective.AllowedIps))
                                        <span class="badge text-bg-light border ms-1 origin">@effective.AllowedIpsOrigin</span>
                                    </li>
                                    <li class="list-group-item" id="effective-quotas">
                                        <span class="fw-semibold">Disk quota:</span> @(effective.DiskQuota?.ToString() ?? "unlimited")
                                        <span class="badge text-bg-light border ms-1 origin">@effective.DiskQuotaOrigin</span>
                                        <span class="fw-semibold ms-2">Transfer quota:</span> @(effective.TransferQuota?.ToString() ?? "unlimited")
                                        <span class="badge text-bg-light border ms-1 origin">@effective.TransferQuotaOrigin</span>
                                        <span class="fw-semibold ms-2">Bandwidth:</span> @(effective.Bandwidth?.ToString() ?? "unlimited")
                                        <span class="badge text-bg-light border ms-1 origin">@effective.BandwidthOrigin</span>
                                    </li>
                                </ul>
                            </div>
                        }

                        @if (!form.IsNew)
                        {
                            <p class="small text-body-secondary mb-3">
                                Last successful login: <span id="last-login">@LastLogin(form.LastLoginAt)</span>
                                @if (form.PasswordChangedAt is { } changed)
                                {
                                    <span class="ms-2">Password set: <span id="password-changed">@Date(changed)</span></span>
                                }
                            </p>
                        }

                        <div class="d-flex justify-content-between gap-2">
                            <div>
                                @if (!form.IsNew)
                                {
                                    <button type="button" class="btn btn-outline-danger" @onclick="() => AskDelete(form.Username)"><i class="bi bi-trash"></i> Delete</button>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-secondary" @onclick="CloseForm">Cancel</button>
                                <button type="submit" class="btn btn-primary" id="save-user"><i class="bi bi-floppy"></i> @(form.IsNew ? "Create user" : "Save user")</button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
</div>

<ConfirmDialog @ref="deleteDialog" Title="Delete user" ConfirmText="Delete" OnConfirm="DeleteAsync">
    Delete the user <strong>@pendingDelete</strong>? The user can no longer log in. The files in its storage are not deleted.
</ConfirmDialog>

<ConfirmDialog @ref="removeKeyDialog" Title="Remove the public key" ConfirmText="Remove" OnConfirm="RemoveKey">
    Remove the key <span class="font-monospace-sm">@pendingKeyRemoval?.Fingerprint</span> of <strong>@form?.Username</strong>? The next login with this key is refused.
</ConfirmDialog>

@code {
    private List<User> users = new();
    private IReadOnlySet<int> twoFactorUsers = new HashSet<int>();
    private IReadOnlyList<SshServer.Interfaces.Storage.VirtualFolder> folders = [];
    private IReadOnlyList<string> storageProblems;
    private IReadOnlyList<string> mountProblems;
    private IReadOnlyList<string> groupProblems;
    private IReadOnlyList<SshServer.Interfaces.Groups.Group> groups = [];
    private bool hadGroups;
    private string search = "";
    private UserForm form;
    private string pendingDelete;
    private bool generatingKey;
    private string newKeysText;
    private DateTime? newKeysExpiry;
    private string keyError;
    private PublicKeyEntry pendingKeyRemoval;
    private ConfirmDialog deleteDialog;
    private ConfirmDialog removeKeyDialog;
    private string appPasswordName;
    private bool appPasswordWebDav = true;
    private bool appPasswordSftp;
    private bool appPasswordFtp;
    private DateTime? appPasswordExpiry;
    private string appPasswordError;
    private string newAppPassword;
    private SshServerModule.Quotas.UserQuotaView quotaView;

    private IQueryable<User> FilteredUsers =>
        users.Where(u => string.IsNullOrWhiteSpace(search)
                         || (u.Username ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
                         || (u.UserRootDirectory ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase))
             .AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        LoadUsers();
        await LoadTwoFactorAsync();
    }

    private async Task LoadTwoFactorAsync() =>
        twoFactorUsers = await TwoFactor.ListEnabledAsync(TwoFactorSubjectKind.User, CancellationToken.None);

    private void LoadUsers()
    {
        users = SettingsRepository.GetAllUsers();
        folders = FolderService.List();
        groups = GroupService.List();
    }

    private void StartNew()
    {
        ResetKeyInput();
        form = UserForm.New();
        quotaView = null;
        hadGroups = false;
        ClearProblems();
    }

    private async Task Edit(User user)
    {
        ResetKeyInput();
        var stored = SettingsRepository.GetUser(user.Username);
        form = stored is null ? null : UserForm.From(stored, StorageService);
        AfterFormLoaded();
        ClearProblems();
        await LoadQuotaAsync();
    }

    /// <summary>The quota usage of the open user (issue #62).</summary>
    private async Task LoadQuotaAsync() =>
        quotaView = form is null || form.IsNew ? null : await QuotaService.GetAsync(form.Username, System.Threading.CancellationToken.None);

    private async Task RescanQuota()
    {
        if (form is null)
            return;
        if (QuotaService.RequestScan(form.Username))
            Toasts.ShowSuccess($"A scan of the quota usage of {form.Username} was started. Its result is shown when you open the user again.");
        else
            Toasts.ShowError($"The user {form.Username} does not exist any more.");
        await LoadQuotaAsync();
    }

    private async Task ResetTransferAsync()
    {
        if (form is null)
            return;
        if (await QuotaService.ResetTransferAsync(form.Username, System.Threading.CancellationToken.None))
            Toasts.ShowSuccess($"The transfer counters of {form.Username} were reset.");
        else
            Toasts.ShowError($"The user {form.Username} does not exist any more.");
        await LoadQuotaAsync();
    }

    /// <summary>A byte count for people: "512 bytes", "1.5 MiB".</summary>
    private static string Size(long bytes)
    {
        bytes = Math.Max(0, bytes);
        string[] units = ["bytes", "KiB", "MiB", "GiB", "TiB"];
        double value = bytes;
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }
        return unit == 0 ? $"{bytes} bytes" : value.ToString("0.##", CultureInfo.InvariantCulture) + " " + units[unit];
    }

    private void CloseForm() => form = null;

    private void AfterFormLoaded()
    {
        if (form is null)
            return;
        hadGroups = form.HasGroups;
        form.GroupProvidesStorage = SelectedGroups().Any(g => g.Storage is not null);
    }

    private void ClearProblems()
    {
        storageProblems = null;
        mountProblems = null;
        groupProblems = null;
    }

    /// <summary>The storage of "/" from the form, or false with the problems shown in the form.</summary>
    private bool TryBuildStorage(out SshServer.Interfaces.Storage.StorageConfig storage)
    {
        storage = null;
        ClearProblems();
        var mounts = FolderService.ValidateMounts(form.MountList());
        if (mounts.Count > 0)
            mountProblems = mounts;
        // The groups outside the scope of the administrator are not checked (it cannot see them; they stay as they are).
        var visible = groups.Select(g => g.Id).ToHashSet();
        var membership = new User
        {
            PrimaryGroupId = visible.Contains(form.PrimaryGroupId) ? form.PrimaryGroupId : null,
            SecondaryGroupIds = form.SecondaryGroupIds.Where(visible.Contains).ToList(),
        };
        var groupCheck = GroupService.ValidateMembership(membership);
        if (groupCheck.Count > 0)
            groupProblems = groupCheck;
        if (!form.UsesDefaultStorage)
        {
            var result = StorageService.Build(form.Storage);
            if (!result.IsValid)
                storageProblems = result.Problems;
            storage = result.Config;
        }
        return storageProblems is null && mountProblems is null && groupProblems is null;
    }

    private void ResetKeyInput()
    {
        newKeysText = null;
        newKeysExpiry = null;
        keyError = null;
        appPasswordName = null;
        appPasswordWebDav = true;
        appPasswordSftp = false;
        appPasswordFtp = false;
        appPasswordExpiry = null;
        appPasswordError = null;
        newAppPassword = null;
    }

    private void CreateAppPassword()
    {
        appPasswordError = null;
        newAppPassword = null;
        var protocols = (appPasswordWebDav ? UserProtocols.WebDav : UserProtocols.None) | (appPasswordSftp ? UserProtocols.Sftp : UserProtocols.None)
            | (appPasswordFtp ? UserProtocols.Ftp : UserProtocols.None);
        var expires = appPasswordExpiry is { } date ? DateTime.SpecifyKind(date.Date, DateTimeKind.Utc) : (DateTime?)null;
        try
        {
            var (entry, secret) = UserService.CreateAppPassword(form.Username, appPasswordName, protocols, expires, DateTime.UtcNow);
            newAppPassword = secret;
            appPasswordName = null;
            ReloadAppPasswords(form.Username);
            Toasts.ShowSuccess($"The app password {entry.Name} of {form.Username} was created.");
        }
        catch (UserAdministrationException ex)
        {
            appPasswordError = ex.Message;
        }
    }

    private void RemoveAppPassword(AppPassword appPassword)
    {
        newAppPassword = null;
        try
        {
            if (UserService.RemoveAppPassword(form.Username, appPassword.Id))
                Toasts.ShowSuccess($"The app password {appPassword.Name} of {form.Username} was removed.");
            else
                Toasts.ShowError($"The app password {appPassword.Name} of {form.Username} was not found.");
        }
        catch (UserAdministrationException ex)
        {
            Toasts.ShowError(ex.Message);
        }
        ReloadAppPasswords(form.Username);
    }

    /// <summary>Reloads the app passwords of the open form (the rest of the form keeps what the admin typed).</summary>
    private void ReloadAppPasswords(string username)
    {
        form.AppPasswords = SettingsRepository.GetUser(username)?.AppPasswords?.ToList() ?? new();
        LoadUsers();
    }

    /// <summary>Reloads the keys of the open form after a key change (the rest of the form keeps what the admin typed).</summary>
    private void ReloadKeys(string username)
    {
        form.PublicKeys = SettingsRepository.GetUser(username)?.PublicKeys?.ToList() ?? new();
        LoadUsers();
    }

    private async Task SaveAsync()
    {
        var username = form.Username.Trim();
        if (!TryBuildStorage(out var storage))
        {
            Toasts.ShowError($"The user {username} was not saved: check the storage, the virtual folders and the groups.");
            return;
        }
        if (form.IsNew)
        {
            var user = new User();
            // Hash off the circuit's synchronization context: PBKDF2 with 600,000 iterations takes a moment.
            await Task.Run(() => form.ApplyTo(user));
            user.Storage = storage;
            bool added;
            try
            {
                added = UserService.TryAdd(user);
            }
            catch (AdminAccessDeniedException ex)
            {
                Toasts.ShowError(ex.Message);
                return;
            }
            if (!added)
            {
                Toasts.ShowError($"The user {username} could not be created. Is the name already used?");
                return;
            }
            Toasts.ShowSuccess($"The user {username} was created.");
        }
        else
        {
            var user = SettingsRepository.GetUser(username);
            if (user is null)
            {
                Toasts.ShowError($"The user {username} does not exist any more.");
                LoadUsers();
                form = null;
                return;
            }
            await Task.Run(() => form.ApplyTo(user));
            user.Storage = storage;
            bool updated;
            try
            {
                updated = SettingsRepository.UpdateUser(user);
            }
            catch (AdminAccessDeniedException ex)
            {
                Toasts.ShowError(ex.Message);
                return;
            }
            if (!updated)
            {
                Toasts.ShowError($"The user {username} could not be saved.");
                return;
            }
            Toasts.ShowSuccess($"The user {username} was saved.");
        }

        LoadUsers();
        form = UserForm.From(SettingsRepository.GetUser(username), StorageService);
        AfterFormLoaded();
        await LoadQuotaAsync();
    }

    private void AskDelete(string username)
    {
        pendingDelete = username;
        deleteDialog.Open();
    }

    private Task DeleteAsync()
    {
        if (UserService.Remove(pendingDelete))
        {
            Toasts.ShowSuccess($"The user {pendingDelete} was deleted.");
            if (form?.Username == pendingDelete)
                form = null;
        }
        else
        {
            Toasts.ShowError($"The user {pendingDelete} could not be deleted.");
        }
        LoadUsers();
        return Task.CompletedTask;
    }

    private void AddKeys()
    {
        keyError = null;
        if (string.IsNullOrWhiteSpace(newKeysText))
        {
            keyError = "Paste one or more public keys first.";
            return;
        }
        var expires = newKeysExpiry is { } date ? DateTime.SpecifyKind(date.Date, DateTimeKind.Utc) : (DateTime?)null;
        try
        {
            var (added, skipped) = UserService.AddPublicKeys(form.Username, newKeysText, expires);
            ReloadKeys(form.Username);
            newKeysText = null;
            Toasts.ShowSuccess(skipped == 0
                ? $"Added {added} key(s) to {form.Username}."
                : $"Added {added} key(s) to {form.Username}; {skipped} key(s) were already in the list.");
        }
        catch (UserAdministrationException ex)
        {
            keyError = ex.Message;
        }
    }

    private async Task GenerateKeyAsync(bool ed25519)
    {
        var username = form.Username;
        generatingKey = true;
        try
        {
            var comment = $"{username}@freesftpsharp";
            var key = await Task.Run(() => ed25519
                ? UserKeyGenerator.GenerateEd25519(comment, DateTime.UtcNow)
                : UserKeyGenerator.GenerateRsa(comment, DateTime.UtcNow));

            try
            {
                UserService.AddPublicKey(username, key.PublicKey);
            }
            catch (UserAdministrationException ex)
            {
                Toasts.ShowError(ex.Message);
                return;
            }

            var fileName = (ed25519 ? $"{username}_ed25519" : username) + key.FileExtension;
            var downloaded = await JS.SaveFile(System.Text.Encoding.UTF8.GetBytes(key.PrivateKey), fileName);
            ReloadKeys(username);
            if (!downloaded)
            {
                Toasts.ShowError($"The new key of {username} was saved, but the browser could not download the private key. Remove the key and generate a new one.");
                return;
            }
            Toasts.ShowSuccess($"A new key was added for {username}. Keep the downloaded private key safe; it is not stored on the server.");
        }
        finally
        {
            generatingKey = false;
        }
    }

    private void AskRemoveKey(PublicKeyEntry key)
    {
        pendingKeyRemoval = key;
        removeKeyDialog.Open();
    }

    private void RemoveKey()
    {
        var key = pendingKeyRemoval;
        if (key is null || form is null)
            return;
        try
        {
            if (UserService.RemovePublicKey(form.Username, key.KeyBase64))
                Toasts.ShowSuccess($"The key {key.Fingerprint} of {form.Username} was removed.");
            else
                Toasts.ShowError($"The key {key.Fingerprint} of {form.Username} was not found.");
        }
        catch (UserAdministrationException ex)
        {
            Toasts.ShowError(ex.Message);
        }
        ReloadKeys(form.Username);
    }

    private static string Date(DateTime value) => value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private static string LastLogin(DateTime? value) =>
        value is { } time ? time.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) : "never";

    private string GroupNames(User user)
    {
        var ids = new List<int>();
        if (user.PrimaryGroupId is { } primary)
            ids.Add(primary);
        ids.AddRange(user.SecondaryGroupIds ?? new List<int>());
        return string.Join(", ", ids.Select(id => groups.FirstOrDefault(g => g.Id == id)?.Name).Where(n => n is not null));
    }

    private void OnPrimaryGroupChanged(ChangeEventArgs e)
    {
        form.PrimaryGroupId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        form.SecondaryGroupIds.Remove(form.PrimaryGroupId);
        UpdateGroupState();
    }

    private void ToggleSecondaryGroup(int id, bool selected)
    {
        form.SecondaryGroupIds.Remove(id);
        if (selected)
            form.SecondaryGroupIds.Add(id);
        UpdateGroupState();
    }

    /// <summary>A user that joins its first group takes the rules of the group, unless it has rules of its own.</summary>
    private void UpdateGroupState()
    {
        form.GroupProvidesStorage = SelectedGroups().Any(g => g.Storage is not null);
        if (!form.HasGroups)
            form.InheritPermissions = false;
        else if (!hadGroups && PermissionTables.IsRootAllOnly(form.Permissions) && form.PathFilters.Count == 0)
            form.InheritPermissions = true;
        hadGroups = form.HasGroups;
    }

    private IEnumerable<SshServer.Interfaces.Groups.Group> SelectedGroups() =>
        groups.Where(g => g.Id == form.PrimaryGroupId || form.SecondaryGroupIds.Contains(g.Id));

    /// <summary>The effective settings of the form as it is now (not saved), with the groups.</summary>
    private SshServer.Interfaces.Users.EffectiveUserSettings Preview()
    {
        var user = new User { Username = form.Username?.Trim() ?? "" };
        form.ApplySettingsTo(user);
        user.Storage = form.UsesDefaultStorage ? null : new SshServer.Interfaces.Storage.StorageConfig { Provider = form.Storage.Provider };
        return UserSettings.Resolve(user);
    }

    private static string PermissionText(FilePermissions permissions) =>
        permissions == FilePermissions.All ? "all" : permissions == FilePermissions.None ? "none"
            : string.Join(", ", PermissionRow.Columns.Where(c => (permissions & c.Flag) == c.Flag).Select(c => c.Title));
}
