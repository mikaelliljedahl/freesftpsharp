@page "/users"
@attribute [Authorize(Policy = AdminPolicies.ManageUsers)]
@using FxSsh.SshServerModule
@using System.Globalization
@using SshServer.Interfaces.Permissions
@using SshServer.Interfaces.Authentication
@using SshServer.Interfaces.Users
@inject AdminScopedSettingsRepository SettingsRepository
@inject SshServer.Interfaces.Users.UserAdministrationService UserService
@inject SshServerModule.Storage.StorageConfigService StorageService
@inject SshServerModule.Storage.VirtualFolderService FolderService
@inject IJSRuntime JS
@inject ToastService Toasts

<PageTitle>Users - FreeSftpSharp admin</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h1 class="h3 mb-0">Users</h1>
        <p class="text-body-secondary mb-0">The SFTP accounts. Each user sees only its own storage and virtual folders, with the permissions set per path.</p>
    </div>
    <button type="button" class="btn btn-primary" @onclick="StartNew" id="add-user"><i class="bi bi-person-plus"></i> Add user</button>
</div>

<div class="row g-4">
    <div class="@(form is null ? "col-12" : "col-xl-5")">
        <div class="card">
            <div class="card-header">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="search" class="form-control" placeholder="Search users" aria-label="Search users" id="user-search"
                           @bind="search" @bind:event="oninput" />
                </div>
            </div>
            @if (users.Count == 0)
            {
                <div class="card-body text-body-secondary" id="no-users">No users yet. Use "Add user" to create the first one.</div>
            }
            else
            {
                <div class="table-responsive">
                    <QuickGrid Items="FilteredUsers" Class="table table-hover align-middle quickgrid-table" id="user-table">
                        <PropertyColumn Title="User name" Property="@(u => u.Username)" Sortable="true" InitialSortDirection="SortDirection.Ascending" IsDefaultSortColumn="true" />
                        <TemplateColumn Title="Login">
                            @if (!string.IsNullOrWhiteSpace(context.HashedPassword))
                            {
                                <span class="badge text-bg-secondary me-1">password</span>
                            }
                            @if (context.PublicKeys is { Count: > 0 } keys)
                            {
                                <span class="badge text-bg-info me-1">@(keys.Count == 1 ? "key" : $"{keys.Count} keys")</span>
                            }
                            @if (context.RequireAllOf is { Count: > 0 })
                            {
                                <span class="badge text-bg-primary me-1" title="Multi-step login">@context.RequireAllOf.Count-step</span>
                            }
                            @if (context.OnlyWhitelistedIps && context.WhitelistedIps is { Count: > 0 })
                            {
                                <span class="badge text-bg-warning" title="Only from whitelisted networks">IP</span>
                            }
                        </TemplateColumn>
                        @if (form is null)
                        {
                            <TemplateColumn Title="Storage" SortBy="@(GridSort<User>.ByAscending(u => u.Storage == null ? u.UserRootDirectory : u.Storage.Provider))" Class="d-none d-md-table-cell">
                                @if (context.Storage is null)
                                {
                                    <span class="font-monospace-sm">@context.UserRootDirectory</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-light border">@StorageService.DisplayName(context.Storage)</span>
                                }
                                @if (context.VirtualFolders is { Count: > 0 } mounts)
                                {
                                    <span class="badge text-bg-secondary ms-1" title="Virtual folders">+@mounts.Count @(mounts.Count == 1 ? "folder" : "folders")</span>
                                }
                            </TemplateColumn>
                            <TemplateColumn Title="Last login (UTC)" SortBy="@(GridSort<User>.ByAscending(u => u.LastSuccessfulLogin))" Class="d-none d-md-table-cell">
                                @LastLogin(context.LastSuccessfulLogin)
                            </TemplateColumn>
                        }
                        <TemplateColumn Title="" Align="Align.End">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-primary edit-user" title="Edit" aria-label="Edit @context.Username" @onclick="() => Edit(context)"><i class="bi bi-pencil"></i></button>
                                <button type="button" class="btn btn-outline-danger delete-user" title="Delete" aria-label="Delete @context.Username" @onclick="() => AskDelete(context.Username)"><i class="bi bi-trash"></i></button>
                            </div>
                        </TemplateColumn>
                    </QuickGrid>
                </div>
            }
        </div>
    </div>

    @if (form is not null)
    {
        <div class="col-xl-7">
            <div class="card">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                    <span>@(form.IsNew ? "New user" : $"Edit {form.Username}")</span>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseForm"></button>
                </div>
                <div class="card-body">
                    <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="user-form" id="user-form">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label" for="username">User name</label>
                            <InputText id="username" class="form-control" @bind-Value="form.Username" readonly="@(!form.IsNew)" autocomplete="off" />
                            <ValidationMessage For="() => form.Username" />
                            @if (!form.IsNew)
                            {
                                <div class="form-text">The user name cannot be changed. Create a new user instead.</div>
                            }
                        </div>

                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 fs-6 mb-0">Storage</legend>
                            <StorageEditor Settings="form.Storage" IdPrefix="user-storage" Problems="storageProblems"
                                           DefaultLabel="Default: a directory on the server" OnProviderChanged="() => storageProblems = null" />
                        @if (form.UsesDefaultStorage)
                        {
                        <div class="mb-0">
                            <label class="form-label" for="root-directory">Root directory</label>
                            <InputText id="root-directory" class="form-control font-monospace" @bind-Value="form.UserRootDirectory" placeholder="/srv/sftp/user" />
                            <ValidationMessage For="() => form.UserRootDirectory" />
                            @if (!string.IsNullOrWhiteSpace(form.UserRootDirectory) && !System.IO.Directory.Exists(form.UserRootDirectory.Trim()))
                            {
                                <div class="form-text text-warning-emphasis" id="root-missing"><i class="bi bi-exclamation-triangle"></i> This directory does not exist on the server. The user cannot work with files until it is created.</div>
                            }
                            else
                            {
                                <div class="form-text">A directory on the server. The user sees it as <code>/</code> and cannot leave it.</div>
                            }
                        </div>
                        }
                        </fieldset>

                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 fs-6 mb-0">Virtual folders</legend>
                            <div class="small text-body-secondary mb-2">
                                Other storage locations that the user sees as directories, for example a shared S3 prefix at <code>/incoming</code>.
                                A file cannot be renamed between two storages. Manage the folders on the <a href="virtual-folders">Virtual folders</a> page.
                            </div>
                            @if (form.Mounts.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-2" id="mount-table">
                                        <thead>
                                            <tr>
                                                <th scope="col">Virtual folder</th>
                                                <th scope="col">Mount path</th>
                                                <th scope="col"><span class="visually-hidden">Remove</span></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (var i = 0; i < form.Mounts.Count; i++)
                                            {
                                                var row = form.Mounts[i];
                                                var index = i;
                                                <tr class="mount-row">
                                                    <td style="min-width: 10rem">
                                                        <select class="form-select form-select-sm" id="mount-folder-@index" aria-label="Virtual folder"
                                                                value="@row.VirtualFolderId" @onchange="e => row.VirtualFolderId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0">
                                                            <option value="0">Select a folder</option>
                                                            @foreach (var folder in folders)
                                                            {
                                                                <option value="@folder.Id">@folder.Name</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td style="min-width: 10rem">
                                                        <input type="text" class="form-control form-control-sm font-monospace" id="mount-path-@index" aria-label="Mount path"
                                                               placeholder="/shared" value="@row.MountPath" @onchange="e => row.MountPath = e.Value?.ToString() ?? string.Empty" />
                                                    </td>
                                                    <td class="text-end">
                                                        <button type="button" class="btn btn-sm btn-outline-danger remove-mount" title="Remove" aria-label="Remove the mount @row.MountPath"
                                                                @onclick="() => form.Mounts.RemoveAt(index)"><i class="bi bi-x"></i></button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            @if (mountProblems is { Count: > 0 })
                            {
                                <ul class="text-danger small mb-2 ps-3" id="mount-problems">
                                    @foreach (var problem in mountProblems)
                                    {
                                        <li>@problem</li>
                                    }
                                </ul>
                            }
                            @if (folders.Count == 0)
                            {
                                <div class="small text-body-secondary" id="no-folders">There are no virtual folders yet.</div>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary" id="add-mount"
                                        @onclick="AddMount"><i class="bi bi-plus"></i> Mount a folder</button>
                            }
                        </fieldset>

                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 fs-6 mb-0">Password</legend>
                            <div class="small text-body-secondary mb-2">
                                @if (form.HasPassword)
                                {
                                    <span>A password is set. Enter a new one to change it.</span>
                                }
                                else
                                {
                                    <span>No password is set.</span>
                                }
                                Passwords are stored as salted PBKDF2-SHA256 hashes.
                            </div>
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <label class="form-label" for="new-password">New password</label>
                                    <InputText id="new-password" type="password" class="form-control" @bind-Value="form.NewPassword" autocomplete="new-password" />
                                    <ValidationMessage For="() => form.NewPassword" />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label" for="confirm-password">Repeat the password</label>
                                    <InputText id="confirm-password" type="password" class="form-control" @bind-Value="form.ConfirmPassword" autocomplete="new-password" />
                                    <ValidationMessage For="() => form.ConfirmPassword" />
                                </div>
                            </div>
                            @if (form.HasPassword)
                            {
                                <div class="form-check mt-2">
                                    <InputCheckbox id="remove-password" class="form-check-input" @bind-Value="form.RemovePassword" />
                                    <label class="form-check-label" for="remove-password">Remove the password (the user then logs in with a key only)</label>
                                </div>
                            }
                        </fieldset>

                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 fs-6 mb-0">Public keys</legend>
                            @if (form.IsNew)
                            {
                                <div class="small text-body-secondary">Save the user first, then add or generate keys.</div>
                            }
                            else
                            {
                                @if (form.PublicKeys.Count == 0)
                                {
                                    <div class="small text-body-secondary mb-2" id="no-keys">No keys. Add the public key of the user (an OpenSSH <code>.pub</code> line or an <code>authorized_keys</code> file), or generate one: the server keeps the public key, and your browser downloads the private key once.</div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle mb-2" id="key-table">
                                            <thead>
                                                <tr>
                                                    <th scope="col">Type</th>
                                                    <th scope="col">Fingerprint</th>
                                                    <th scope="col">Comment</th>
                                                    <th scope="col">Added (UTC)</th>
                                                    <th scope="col">Expires (UTC)</th>
                                                    <th scope="col"><span class="visually-hidden">Remove</span></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var key in form.PublicKeys)
                                                {
                                                    <tr class="key-row">
                                                        <td class="small text-nowrap">@key.KeyType</td>
                                                        <td><span class="font-monospace-sm key-fingerprint">@key.Fingerprint</span></td>
                                                        <td class="small">@key.Comment</td>
                                                        <td class="small text-nowrap">@Date(key.AddedAt)</td>
                                                        <td class="small text-nowrap">
                                                            @if (key.ExpiresAt is { } expires)
                                                            {
                                                                @Date(expires)
                                                                @if (key.IsExpired(DateTime.UtcNow))
                                                                {
                                                                    <span class="badge text-bg-danger ms-1">expired</span>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <span class="text-body-secondary">never</span>
                                                            }
                                                        </td>
                                                        <td class="text-end">
                                                            <button type="button" class="btn btn-sm btn-outline-danger remove-key" title="Remove" aria-label="Remove the key @key.Fingerprint"
                                                                    @onclick="() => AskRemoveKey(key)"><i class="bi bi-x"></i></button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                <label class="form-label small mb-1" for="new-keys">Add keys</label>
                                <textarea id="new-keys" class="form-control form-control-sm font-monospace mb-2" rows="3" placeholder="ssh-ed25519 AAAA... user@laptop"
                                          @bind="newKeysText"></textarea>
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <label class="small" for="new-keys-expiry">Expires on (UTC, optional)</label>
                                    <input type="date" id="new-keys-expiry" class="form-control form-control-sm w-auto" @bind="newKeysExpiry" />
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddKeys" id="add-keys"><i class="bi bi-plus"></i> Add from text</button>
                                </div>
                                @if (keyError is not null)
                                {
                                    <div class="small text-danger mb-2" id="key-error" style="white-space: pre-line">@keyError</div>
                                }
                                <div class="form-text mb-2">One key per line: ed25519, ECDSA or RSA (at least 2048 bits). Options such as <code>from=</code> or <code>restrict</code> are not supported. A login compares the whole key.</div>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => GenerateKeyAsync(ed25519: true)" disabled="@generatingKey" id="generate-ed25519-key">
                                        <i class="bi bi-key"></i> Generate an ed25519 key
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => GenerateKeyAsync(ed25519: false)" disabled="@generatingKey" id="generate-key">
                                        @if (generatingKey)
                                        {
                                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                        }
                                        <i class="bi bi-key"></i> Generate an RSA key
                                    </button>
                                </div>
                            }
                        </fieldset>

                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 fs-6 mb-0">Login methods</legend>
                            <div class="form-check form-check-inline">
                                <InputCheckbox id="allow-password" class="form-check-input" @bind-Value="form.AllowPassword" />
                                <label class="form-check-label" for="allow-password">Password</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <InputCheckbox id="allow-public-key" class="form-check-input" @bind-Value="form.AllowPublicKey" />
                                <label class="form-check-label" for="allow-public-key">Public key</label>
                            </div>
                            <div class="mt-2">
                                <label class="form-label small mb-1" for="multi-step">Multi-step login</label>
                                <InputSelect id="multi-step" class="form-select form-select-sm w-auto" @bind-Value="form.MultiStep">
                                    <option value="">Off: one allowed method is enough</option>
                                    <option value="@UserForm.KeyThenPassword">Public key, then password</option>
                                    <option value="@UserForm.PasswordThenKey">Password, then public key</option>
                                </InputSelect>
                            </div>
                            <ValidationMessage For="() => form.AllowPassword" />
                            <div class="form-text">A method that is not allowed fails like a wrong password. With a multi-step login the user needs both methods, in this order.</div>
                        </fieldset>

                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 fs-6 mb-0">IP whitelist</legend>
                            <div class="form-check form-switch mb-2">
                                <InputCheckbox id="user-whitelist-mode" class="form-check-input" @bind-Value="form.OnlyWhitelistedIps" />
                                <label class="form-check-label" for="user-whitelist-mode">This user may log in only from these networks</label>
                            </div>
                            <InputTextArea id="user-whitelist" class="form-control font-monospace" rows="3" @bind-Value="form.WhitelistedIps" placeholder="192.168.1.0/24" />
                            <ValidationMessage For="() => form.WhitelistedIps" />
                            <div class="form-text">CIDR networks or single addresses, one per line. With an empty list nothing is checked.</div>
                        </fieldset>

                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 fs-6 mb-0">Permissions</legend>
                            <div class="small text-body-secondary mb-2">
                                What the user may do in each directory. The most specific path wins: the permissions of
                                <code>/incoming</code> also apply to <code>/incoming/2026</code>, until that path has its own row.
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-2" id="permission-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">Path</th>
                                            @foreach (var column in PermissionRow.Columns)
                                            {
                                                <th scope="col" class="text-center small" title="@column.Description">@column.Title</th>
                                            }
                                            <th scope="col"><span class="visually-hidden">Remove</span></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < form.Permissions.Count; i++)
                                        {
                                            var row = form.Permissions[i];
                                            var index = i;
                                            <tr class="permission-row">
                                                <td style="min-width: 10rem">
                                                    <input type="text" class="form-control form-control-sm font-monospace" id="permission-path-@index" aria-label="Path"
                                                           value="@row.Path" readonly="@(index == 0)" placeholder="/incoming"
                                                           @onchange="e => row.Path = e.Value?.ToString() ?? string.Empty" />
                                                </td>
                                                @foreach (var column in PermissionRow.Columns)
                                                {
                                                    var flag = column.Flag;
                                                    <td class="text-center">
                                                        <input type="checkbox" class="form-check-input" id="permission-@index-@flag" aria-label="@column.Title in @row.Path"
                                                               checked="@row.Has(flag)" @onchange="e => row.Set(flag, e.Value is true)" />
                                                    </td>
                                                }
                                                <td class="text-end">
                                                    @if (index > 0)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-danger remove-permission" title="Remove" aria-label="Remove the row @row.Path"
                                                                @onclick="() => form.Permissions.RemoveAt(index)"><i class="bi bi-x"></i></button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <ValidationMessage For="() => form.Permissions" />
                            <button type="button" class="btn btn-sm btn-outline-primary" id="add-permission"
                                    @onclick="() => form.Permissions.Add(new PermissionRow { Permissions = FilePermissions.All })"><i class="bi bi-plus"></i> Add a path</button>
                        </fieldset>

                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 fs-6 mb-0">Path filters</legend>
                            <div class="small text-body-secondary mb-2">
                                File name patterns with <code>*</code> and <code>?</code>, separated by commas; case is ignored.
                                With allowed patterns, only matching files can be uploaded, downloaded, renamed or deleted.
                                Denied patterns are refused. Hidden files and directories are not listed and do not exist for the user.
                            </div>
                            @if (form.PathFilters.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-2" id="filter-table">
                                        <thead>
                                            <tr>
                                                <th scope="col">Path</th>
                                                <th scope="col">Allowed</th>
                                                <th scope="col">Denied</th>
                                                <th scope="col">Hidden</th>
                                                <th scope="col"><span class="visually-hidden">Remove</span></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (var i = 0; i < form.PathFilters.Count; i++)
                                            {
                                                var row = form.PathFilters[i];
                                                var index = i;
                                                <tr class="filter-row">
                                                    <td style="min-width: 8rem"><input type="text" class="form-control form-control-sm font-monospace" id="filter-path-@index" aria-label="Path" placeholder="/"
                                                                                       value="@row.Path" @onchange="e => row.Path = e.Value?.ToString() ?? string.Empty" /></td>
                                                    <td><input type="text" class="form-control form-control-sm font-monospace" id="filter-allowed-@index" aria-label="Allowed patterns" placeholder="*.csv"
                                                               value="@row.Allowed" @onchange="e => row.Allowed = e.Value?.ToString() ?? string.Empty" /></td>
                                                    <td><input type="text" class="form-control form-control-sm font-monospace" id="filter-denied-@index" aria-label="Denied patterns" placeholder="*.exe"
                                                               value="@row.Denied" @onchange="e => row.Denied = e.Value?.ToString() ?? string.Empty" /></td>
                                                    <td><input type="text" class="form-control form-control-sm font-monospace" id="filter-hidden-@index" aria-label="Hidden patterns" placeholder=".git"
                                                               value="@row.Hidden" @onchange="e => row.Hidden = e.Value?.ToString() ?? string.Empty" /></td>
                                                    <td class="text-end">
                                                        <button type="button" class="btn btn-sm btn-outline-danger remove-filter" title="Remove" aria-label="Remove the filter of @row.Path"
                                                                @onclick="() => form.PathFilters.RemoveAt(index)"><i class="bi bi-x"></i></button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            <ValidationMessage For="() => form.PathFilters" />
                            <button type="button" class="btn btn-sm btn-outline-primary" id="add-filter"
                                    @onclick="() => form.PathFilters.Add(new PathFilterRow { Path = form.PathFilters.Count == 0 ? SshServer.Interfaces.Storage.VirtualPath.Root : string.Empty })"><i class="bi bi-plus"></i> Add a filter</button>
                        </fieldset>

                        @if (!form.IsNew)
                        {
                            <p class="small text-body-secondary mb-3">Last successful login: <span id="last-login">@LastLogin(form.LastSuccessfulLogin)</span></p>
                        }

                        <div class="d-flex justify-content-between gap-2">
                            <div>
                                @if (!form.IsNew)
                                {
                                    <button type="button" class="btn btn-outline-danger" @onclick="() => AskDelete(form.Username)"><i class="bi bi-trash"></i> Delete</button>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-secondary" @onclick="CloseForm">Cancel</button>
                                <button type="submit" class="btn btn-primary" id="save-user"><i class="bi bi-floppy"></i> @(form.IsNew ? "Create user" : "Save user")</button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
</div>

<ConfirmDialog @ref="deleteDialog" Title="Delete user" ConfirmText="Delete" OnConfirm="DeleteAsync">
    Delete the user <strong>@pendingDelete</strong>? The user can no longer log in. The files in its storage are not deleted.
</ConfirmDialog>

<ConfirmDialog @ref="removeKeyDialog" Title="Remove the public key" ConfirmText="Remove" OnConfirm="RemoveKey">
    Remove the key <span class="font-monospace-sm">@pendingKeyRemoval?.Fingerprint</span> of <strong>@form?.Username</strong>? The next login with this key is refused.
</ConfirmDialog>

@code {
    private List<User> users = new();
    private IReadOnlyList<SshServer.Interfaces.Storage.VirtualFolder> folders = [];
    private IReadOnlyList<string> storageProblems;
    private IReadOnlyList<string> mountProblems;
    private string search = "";
    private UserForm form;
    private string pendingDelete;
    private bool generatingKey;
    private string newKeysText;
    private DateTime? newKeysExpiry;
    private string keyError;
    private PublicKeyEntry pendingKeyRemoval;
    private ConfirmDialog deleteDialog;
    private ConfirmDialog removeKeyDialog;

    private IQueryable<User> FilteredUsers =>
        users.Where(u => string.IsNullOrWhiteSpace(search)
                         || (u.Username ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
                         || (u.UserRootDirectory ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase))
             .AsQueryable();

    protected override void OnInitialized() => LoadUsers();

    private void LoadUsers()
    {
        users = SettingsRepository.GetAllUsers();
        folders = FolderService.List();
    }

    private void StartNew()
    {
        ResetKeyInput();
        form = UserForm.New();
        ClearProblems();
    }

    private void Edit(User user)
    {
        ResetKeyInput();
        var stored = SettingsRepository.GetUser(user.Username);
        form = stored is null ? null : UserForm.From(stored, StorageService);
        ClearProblems();
    }

    private void CloseForm() => form = null;

    private void ClearProblems()
    {
        storageProblems = null;
        mountProblems = null;
    }

    private void AddMount()
    {
        var first = folders.FirstOrDefault(f => !form.Mounts.Any(m => m.VirtualFolderId == f.Id)) ?? folders[0];
        form.Mounts.Add(new MountRow { VirtualFolderId = first.Id, MountPath = "/" + first.Name });
    }

    /// <summary>The storage of "/" from the form, or false with the problems shown in the form.</summary>
    private bool TryBuildStorage(out SshServer.Interfaces.Storage.StorageConfig storage)
    {
        storage = null;
        ClearProblems();
        var mounts = FolderService.ValidateMounts(form.MountList());
        if (mounts.Count > 0)
            mountProblems = mounts;
        if (!form.UsesDefaultStorage)
        {
            var result = StorageService.Build(form.Storage);
            if (!result.IsValid)
                storageProblems = result.Problems;
            storage = result.Config;
        }
        return storageProblems is null && mountProblems is null;
    }

    private void ResetKeyInput()
    {
        newKeysText = null;
        newKeysExpiry = null;
        keyError = null;
    }

    /// <summary>Reloads the keys of the open form after a key change (the rest of the form keeps what the admin typed).</summary>
    private void ReloadKeys(string username)
    {
        form.PublicKeys = SettingsRepository.GetUser(username)?.PublicKeys?.ToList() ?? new();
        LoadUsers();
    }

    private async Task SaveAsync()
    {
        var username = form.Username.Trim();
        if (!TryBuildStorage(out var storage))
        {
            Toasts.ShowError($"The user {username} was not saved: check the storage and the virtual folders.");
            return;
        }
        if (form.IsNew)
        {
            var user = new User();
            // Hash off the circuit's synchronization context: PBKDF2 with 600,000 iterations takes a moment.
            await Task.Run(() => form.ApplyTo(user));
            user.Storage = storage;
            if (!UserService.TryAdd(user))
            {
                Toasts.ShowError($"The user {username} could not be created. Is the name already used?");
                return;
            }
            Toasts.ShowSuccess($"The user {username} was created.");
        }
        else
        {
            var user = SettingsRepository.GetUser(username);
            if (user is null)
            {
                Toasts.ShowError($"The user {username} does not exist any more.");
                LoadUsers();
                form = null;
                return;
            }
            await Task.Run(() => form.ApplyTo(user));
            user.Storage = storage;
            if (!SettingsRepository.UpdateUser(user))
            {
                Toasts.ShowError($"The user {username} could not be saved.");
                return;
            }
            Toasts.ShowSuccess($"The user {username} was saved.");
        }

        LoadUsers();
        form = UserForm.From(SettingsRepository.GetUser(username), StorageService);
    }

    private void AskDelete(string username)
    {
        pendingDelete = username;
        deleteDialog.Open();
    }

    private Task DeleteAsync()
    {
        if (UserService.Remove(pendingDelete))
        {
            Toasts.ShowSuccess($"The user {pendingDelete} was deleted.");
            if (form?.Username == pendingDelete)
                form = null;
        }
        else
        {
            Toasts.ShowError($"The user {pendingDelete} could not be deleted.");
        }
        LoadUsers();
        return Task.CompletedTask;
    }

    private void AddKeys()
    {
        keyError = null;
        if (string.IsNullOrWhiteSpace(newKeysText))
        {
            keyError = "Paste one or more public keys first.";
            return;
        }
        var expires = newKeysExpiry is { } date ? DateTime.SpecifyKind(date.Date, DateTimeKind.Utc) : (DateTime?)null;
        try
        {
            var (added, skipped) = UserService.AddPublicKeys(form.Username, newKeysText, expires);
            ReloadKeys(form.Username);
            newKeysText = null;
            Toasts.ShowSuccess(skipped == 0
                ? $"Added {added} key(s) to {form.Username}."
                : $"Added {added} key(s) to {form.Username}; {skipped} key(s) were already in the list.");
        }
        catch (UserAdministrationException ex)
        {
            keyError = ex.Message;
        }
    }

    private async Task GenerateKeyAsync(bool ed25519)
    {
        var username = form.Username;
        generatingKey = true;
        try
        {
            var comment = $"{username}@freesftpsharp";
            var key = await Task.Run(() => ed25519
                ? UserKeyGenerator.GenerateEd25519(comment, DateTime.UtcNow)
                : UserKeyGenerator.GenerateRsa(comment, DateTime.UtcNow));

            try
            {
                UserService.AddPublicKey(username, key.PublicKey);
            }
            catch (UserAdministrationException ex)
            {
                Toasts.ShowError(ex.Message);
                return;
            }

            var fileName = (ed25519 ? $"{username}_ed25519" : username) + key.FileExtension;
            var downloaded = await JS.SaveFile(System.Text.Encoding.UTF8.GetBytes(key.PrivateKey), fileName);
            ReloadKeys(username);
            if (!downloaded)
            {
                Toasts.ShowError($"The new key of {username} was saved, but the browser could not download the private key. Remove the key and generate a new one.");
                return;
            }
            Toasts.ShowSuccess($"A new key was added for {username}. Keep the downloaded private key safe; it is not stored on the server.");
        }
        finally
        {
            generatingKey = false;
        }
    }

    private void AskRemoveKey(PublicKeyEntry key)
    {
        pendingKeyRemoval = key;
        removeKeyDialog.Open();
    }

    private void RemoveKey()
    {
        var key = pendingKeyRemoval;
        if (key is null || form is null)
            return;
        try
        {
            if (UserService.RemovePublicKey(form.Username, key.KeyBase64))
                Toasts.ShowSuccess($"The key {key.Fingerprint} of {form.Username} was removed.");
            else
                Toasts.ShowError($"The key {key.Fingerprint} of {form.Username} was not found.");
        }
        catch (UserAdministrationException ex)
        {
            Toasts.ShowError(ex.Message);
        }
        ReloadKeys(form.Username);
    }

    private static string Date(DateTime value) => value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private static string LastLogin(DateTime value) =>
        value == default ? "never" : value.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
}
