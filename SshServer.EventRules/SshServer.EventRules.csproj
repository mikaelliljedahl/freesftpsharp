<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cron expressions with time zones for the scheduled rules. -->
    <PackageReference Include="Cronos" Version="0.11.0" />
    <!-- SMTP for the Email action (STARTTLS, implicit TLS, authentication). -->
    <PackageReference Include="MailKit" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SshServer.Interfaces\SshServer.Interfaces.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FreeSftpSharp.Tests" />
  </ItemGroup>

</Project>
