{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.HtmlFile"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/FxSshServer.txt",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10000000
        }
      },
      {
        "Name": "HtmlFile",
        "Args": {
          "path": "logs/html/FxSshServer.html",
          "fileSizeLimitBytes": 10000000
        }
      }
    ]
  },
  "Settings": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Settings": "Data Source=freesftpsharp.db"
  }
}
