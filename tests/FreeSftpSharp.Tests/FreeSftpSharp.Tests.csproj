<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>FreeSftpSharp.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- mtp-off: run through VSTest (xunit.runner.visualstudio), so a plain "dotnet test FreeSftpSharp.sln" works without a global.json. -->
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SshServerModule\SshServerModule.csproj" />
    <ProjectReference Include="..\..\SshServer.Filesystem.LocalDisk\SshServer.Filesystem.LocalDisk.csproj" />
    <ProjectReference Include="..\..\SshServer.Interfaces\SshServer.Interfaces.csproj" />
    <ProjectReference Include="..\..\SshServer.Settings.Sql\SshServer.Settings.Sql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
