<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>FreeSftpSharp.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.15.2" />
    <PackageReference Include="FluentFTP" Version="55.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- mtp-off: run through VSTest (xunit.runner.visualstudio), so a plain "dotnet test FreeSftpSharp.sln" works without a global.json. -->
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SshServerModule\SshServerModule.csproj" />
    <ProjectReference Include="..\..\SshServer.Filesystem.LocalDisk\SshServer.Filesystem.LocalDisk.csproj" />
    <ProjectReference Include="..\..\SshServer.Filesystem.AzureBlob\SshServer.Filesystem.AzureBlob.csproj" />
    <ProjectReference Include="..\..\SshServer.Filesystem.S3\SshServer.Filesystem.S3.csproj" />
    <ProjectReference Include="..\..\SshServer.Filesystem.Gcs\SshServer.Filesystem.Gcs.csproj" />
    <ProjectReference Include="..\..\SshServer.Filesystem.Encrypted\SshServer.Filesystem.Encrypted.csproj" />
    <ProjectReference Include="..\..\SshServer.Interfaces\SshServer.Interfaces.csproj" />
    <ProjectReference Include="..\..\SshServer.Observability\SshServer.Observability.csproj" />
    <ProjectReference Include="..\..\SshServer.Settings.Sql\SshServer.Settings.Sql.csproj" />
    <ProjectReference Include="..\..\SshServer.Webhooks\SshServer.Webhooks.csproj" />
    <ProjectReference Include="..\..\SshServer.TwoFactor\SshServer.TwoFactor.csproj" />
    <ProjectReference Include="..\..\SshServer.EventRules\SshServer.EventRules.csproj" />
    <ProjectReference Include="..\..\FxSshSftpServer\FxSshSftpServer.csproj" />
    <!-- Built for ZeroConfigStartTests, which starts the real ServerConsoleApp as a process. Not referenced as an assembly. -->
    <ProjectReference Include="..\..\ServerConsoleApp\ServerConsoleApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\FreeSftpSharp.WebDav\FreeSftpSharp.WebDav.csproj" />
    <ProjectReference Include="..\..\FreeSftpSharp.Ftp\FreeSftpSharp.Ftp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ServerConsoleAppOutput</_Parameter1>
      <_Parameter2>$([MSBuild]::EnsureTrailingSlash('$(MSBuildThisFileDirectory)..\..\ServerConsoleApp\bin\$(Configuration)\$(TargetFramework)'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real app settings, to check the Serilog configuration (issue #33). -->
    <Content Include="..\..\FxSshSftpServer\appsettings.json" Link="AppSettings\FxSshSftpServer.appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\ServerConsoleApp\appsettings.json" Link="AppSettings\ServerConsoleApp.appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\..\FxSshSftpServer\Logging\LogFilePaths.cs" Link="Logging\LogFilePaths.cs" />
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
